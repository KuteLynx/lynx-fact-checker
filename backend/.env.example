# OpenAI-compatible API key (DeepSeek, OpenAI, etc.)
# Crea una cuenta en https://platform.deepseek.com/ y genera una API key
# OPENAI_API_KEY=sk-...

# URL base de la API (default: https://api.deepseek.com/v1)
# LLM_API_URL=https://api.deepseek.com/v1

# Modelo a usar (default: deepseek-chat)
# LLM_MODEL=deepseek-chat
